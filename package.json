{
  "name": "synaptiquiz-3",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma db push --schema prisma/schema.prisma && next dev",
    "build": "npm run db:generate && next build",
    "build:postgres": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "prisma generate --schema prisma/schema.prisma && prisma generate --schema prisma/schema.postgresql.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:generate:postgres": "prisma generate --schema prisma/schema.postgresql.prisma",
    "db:push:postgres": "prisma db push --schema prisma/schema.postgresql.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
